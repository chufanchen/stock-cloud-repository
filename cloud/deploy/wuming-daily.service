[Unit]
Description=Wuming paper account and AI research meeting
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=wuming
Group=wuming
WorkingDirectory=/opt/wuming
EnvironmentFile=/etc/wuming/cloud.env
Environment=PYTHONPATH=/opt/wuming/cloud
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Shanghai
ExecStart=/opt/wuming/.venv/bin/python -m ashare_cloud.runner --work-dir /var/lib/wuming
StateDirectory=wuming
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=55min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wuming
