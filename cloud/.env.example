# 复制为项目根目录 .cloud.env，只在本机填写；不要提交GitHub。
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=YOUR_PRIVATE_BUCKET
R2_PREFIX=wuming-v2
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
AI_BASE_URL=https://YOUR_PROVIDER/v1
AI_MODEL=YOUR_MODEL_ID
AI_API_KEY=REPLACE_ME
# 多角色会议共用上面的接口与密钥；角色与输出额度在 cloud/meeting.json 配置。
# 服务器用同一份字段（无需 export）。DAILY_EXECUTOR 是 GitHub 仓库变量，不填在此处。
# 可选；需stk_auction_o权限。无权限可用腾讯早盘快照回退，见cloud/AUCTION.md。
TUSHARE_TOKEN=
# TickFlow 实时行情/日线首选源。未配置时自动回退；不提供已验证的独立竞价成交额。
TICKFLOW_API_KEY=
TICKFLOW_BASE_URL=https://api.tickflow.org
